   "inLanguage": "es",
   "mainEntity": [
    {
     "@type": "Question",
     "name": "¿Puede un spot con IA enseñar el producto real de una marca?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Sí. Aquí la caja de reparto real del cliente —color, logo y textos impresos— se reprodujo a partir de imágenes de referencia y solo aparece cuando suena el timbre."
     }
    },
    {
     "@type": "Question",
     "name": "¿Puede la comida resultar apetecible en un anuncio generado con IA?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Sí, si se dirige como un rodaje de food: costra dorada y chisporroteo en la sartén, uso real de cuchillo y tenedor y cada plato revisado plano a plano."
     }
    },
    {
     "@type": "Question",
     "name": "¿Puede salir un niño en un spot con IA?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "Sí. Los niños son personajes generados con IA —no se graba a ningún niño real— y la familia se diseña antes de empezar a producir."
     }
    },
    {
     "@type": "Question",
     "name": "¿Necesita un spot con IA rodaje, decorado o equipo?",
     "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. La casa, la familia y cada plano se generaron: sin cámaras, sin equipo y sin alquilar localización. La dirección, el montaje y la revisión funcionan como en cualquier producción."
     }
    }
   ]
